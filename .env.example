SECRET_KEY=change-me-for-production
DATABASE_URL=sqlite:///events.db
OUTREACH_FROM_ADDRESS=EventPlanning@thenuttypelican.com

# Microsoft Graph — leave GRAPH_ENABLED=false until the alias can send.
GRAPH_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
